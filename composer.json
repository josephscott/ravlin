{
	"name": "josephscott/ravlin",
	"description": "A small, secure-by-default PHP framework",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"josephscott/phpcsfixer-config": "0.0.7",
		"pestphp/pest": "5.3.1",
		"phpstan/phpstan": "2.3.1"
	},
	"autoload": {
		"classmap": [ "src/" ]
	},
	"config": {
		"classmap-authoritative": true,
		"optimize-autoloader": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
